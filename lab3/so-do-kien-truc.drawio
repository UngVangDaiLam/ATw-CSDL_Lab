e="Response: server → client" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#374151;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="110" y="721.5" width="182.5" height="17.5" as="geometry"/></mxCell><mxCell id="c56" value="Xử lý bên trong server" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#374151;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="110" y="745.5" width="161.79999999999998" height="17.5" as="geometry"/></mxCell><mxCell id="c57" value="Truy cập dữ liệu" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#374151;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="110" y="769.5" width="120.39999999999999" height="17.5" as="geometry"/></mxCell><mxCell id="c58" value="Thành phần / luồng đề xuất" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#374151;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="110" y="793.5" width="189.4" height="17.5" as="geometry"/></mxCell><mxCell id="c59" value="LUỒNG ĐĂNG NHẬP (theo số thứ tự)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#111827;fontStyle=1;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="360" y="665" width="259.6" height="19" as="geometry"/></mxCell><mxCell id="c60" value="(1) Trình duyệt gửi GET / tới server." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#374151;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="360" y="690.5" width="265.29999999999995" height="17.5" as="geometry"/></mxCell><mxCell id="c61" value="(2) express.static đọc thư mục public/ và trả về HTML, CSS, JS." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#374151;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="360" y="711.0" width="444.7" height="17.5" as="geometry"/></mxCell><mxCell id="c62" value="(3) Người dùng nhập và bấm Đăng nhập; script.js kiểm tra rỗng (rỗng → báo lỗi ngay, không gửi)." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#374151;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="360" y="731.5" width="665.5" height="17.5" as="geometry"/></mxCell><mxCell id="c63" value="(4) fetch() gửi POST /api/login, body JSON {username, password}." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#374151;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="360" y="752.0" width="451.59999999999997" height="17.5" as="geometry"/></mxCell><mxCell id="c64" value="(5) express.json đọc body → validateLogin() (sai → 400) → so khớp với VALID_USER (sai → 401)." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#374151;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="360" y="772.5" width="651.6999999999999" height="17.5" as="geometry"/></mxCell><mxCell id="c65" value="(6) Đúng → express-session tạo session trong MemoryStore: req.session.user = {username, loginAt}." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#374151;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="360" y="793.0" width="679.3" height="17.5" as="geometry"/></mxCell><mxCell id="c66" value="(7) Server trả 200 JSON {success, message} kèm header Set-Cookie: connect.sid; trình duyệt lưu cookie." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#374151;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="360" y="813.5" width="713.8" height="17.5" as="geometry"/></mxCell><mxCell id="c67" value="(8) script.js đọc JSON, hiển thị thông báo xanh/đỏ và đổi giao diện – trang không tải lại (AJAX)." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#374151;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="360" y="834.0" width="679.3" height="17.5" as="geometry"/></mxCell><mxCell id="c68" value="(9) Các request sau tự gửi kèm cookie; GET /api/me tra session → {loggedIn: true, user} (F5 vẫn đăng nhập)." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#374151;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="360" y="854.5" width="748.3" height="17.5" as="geometry"/></mxCell><mxCell id="c69" value="(10) POST /api/logout → session.destroy() + xoá cookie → về trạng thái chưa đăng nhập." style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#374151;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="360" y="875.0" width="603.4" height="17.5" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p1" name="So do tuan tu"><mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1138" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c70" value="&lt;b&gt;SƠ ĐỒ TUẦN TỰ – ĐĂNG NHẬP, KIỂM TRA TRẠNG THÁI VÀ ĐĂNG XUẤT&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="0" y="22" width="1500" height="30" as="geometry"/></mxCell><mxCell id="c71" value="&lt;b&gt;Người dùng&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="220" height="55" as="geometry"/></mxCell><mxCell id="c72" value="&lt;b&gt;Trình duyệt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;(index.html + script.js)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="220" height="55" as="geometry"/></mxCell><mxCell id="c73" value="&lt;b&gt;Express server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;(middleware + router)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="70" width="220" height="55" as="geometry"/></mxCell><mxCell id="c74" value="&lt;b&gt;Session Store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;(MemoryStore)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="70" width="220" height="55" as="geometry"/></mxCell><mxCell id="c75" value="&lt;b&gt;Dữ liệu user&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;(VALID_USER)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="70" width="220" height="55" as="geometry"/></mxCell><mxCell id="c76" value="alt  [ô trống]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=114;height=22;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;fontSize=11;fontColor=#dc2626;strokeColor=#dc2626;dashed=1;dashPattern=6 4;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="288" width="1420" height="70" as="geometry"/></mxCell><mxCell id="c77" value="alt  [dữ liệu không hợp lệ / JSON lỗi]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=282;height=22;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;fontSize=11;fontColor=#dc2626;strokeColor=#dc2626;dashed=1;dashPattern=6 4;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="418" width="1420" height="70" as="geometry"/></mxCell><mxCell id="c78" value="alt  [dữ liệu hợp lệ]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=163;height=22;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;fontSize=11;fontColor=#d97706;strokeColor=#d97706;dashed=1;dashPattern=6 4;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="506" width="1420" height="330" as="geometry"/></mxCell><mxCell id="c79" value="alt  [không khớp]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=135;height=22;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;fontSize=11;fontColor=#dc2626;strokeColor=#dc2626;dashed=1;dashPattern=6 4;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="614" width="1380" height="60" as="geometry"/></mxCell><mxCell id="c80" value="[khớp]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=58;height=22;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;fontSize=11;fontColor=#16a34a;strokeColor=#16a34a;da