<diagram id="p0" name="Ban do kien truc"><mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1500" pageHeight="930" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;BẢN ĐỒ KIẾN TRÚC &amp;amp; LUỒNG DỮ LIỆU – ỨNG DỤNG ĐĂNG NHẬP (Lab 2: HTML/CSS/JS + Node.js Express)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="0" y="22" width="1500" height="30" as="geometry"/></mxCell><mxCell id="c4" value="CLIENT – Trình duyệt (Chrome/Edge)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#93c5fd;verticalAlign=top;fontStyle=1;fontSize=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="340" height="560" as="geometry"/></mxCell><mxCell id="c5" value="MẠNG – HTTP (localhost:3000)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f9fafb;strokeColor=#9ca3af;dashed=1;dashPattern=6 4;verticalAlign=top;fontStyle=1;fontSize=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="390" y="70" width="270" height="560" as="geometry"/></mxCell><mxCell id="c6" value="SERVER – Node.js + Express (server.js)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;verticalAlign=top;fontStyle=1;fontSize=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="680" y="70" width="440" height="560" as="geometry"/></mxCell><mxCell id="c7" value="DỮ LIỆU – Lưu trữ" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#c084fc;verticalAlign=top;fontStyle=1;fontSize=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1140" y="70" width="330" height="560" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Người dùng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;Nhập Username / Password, bấm Đăng nhập&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="105" width="300" height="55" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Giao diện – index.html + style.css&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;Form đăng nhập, ô báo lỗi, vùng thông báo&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="190" width="300" height="65" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Logic client – script.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;validate(): không để trống · fetch() gửi JSON · cập nhật DOM, không reload trang&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="295" width="300" height="85" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Cookie của trình duyệt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;connect.sid (HttpOnly, SameSite=Lax, 30 phút)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="420" width="300" height="65" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Đặc điểm&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;Không tin cậy: người dùng có thể sửa JS, gọi thẳng API bằng curl/Postman → server phải validate lại&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f9fafb;strokeColor=#9ca3af;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="520" width="300" height="85" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;express.static(&quot;public&quot;)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;Trả file tĩnh HTML / CSS / JS&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="105" width="400" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;express.json()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;Đọc body JSON → req.body (JSON lỗi → 400)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="172" width="400" height="45" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;express-session&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;Đọc cookie → nạp req.session&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="235" width="400" height="45" as="geometry"/></mxCell><mxCell id="c16" value="Router – API (JSON)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;verticalAlign=top;fontStyle=1;fontSize=11;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="700" y="300" width="400" height="180" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;POST /api/login&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;Đăng nhập&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="712" y="330" width="180" height="55" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;validateLogin()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;Kiểu, rỗng, độ dài, ký tự&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="908" y="330" width="180" height="55" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;GET /api/me&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;Kiểm tra trạng thái&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="712" y="405" width="180" height="60" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;POST /api/logout&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;Huỷ session, xoá cookie&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="908" y="405" width="180" height="60" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Error handler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;JSON sai → 400 · lỗi khác → 500 (không lộ chi tiết)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="498" width="400" height="45" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Cấu hình&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;PORT=3000 · session secret · VALID_USER = admin / 12345&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f9fafb;strokeColor=#9ca3af;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="558" width="400" height="55" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Thư mục public/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;index.html, style.css, script.js&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="100" width="290" height="60" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Session Store (MemoryStore – RAM)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;sid → { user, loginAt } · mất khi restart server&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="222" width="290" height="70" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Dữ liệu người dùng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;Hằng số VALID_USER trong code&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="322" width="290" height="66" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Database (đề xuất mở rộng)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;MySQL / MongoDB – bảng users, mật khẩu băm bcrypt&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="425" width="290" height="75" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Dịch vụ bên ngoài: không có&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#4b5563&quot;&gt;Có thể thêm: OAuth Google, gửi email OTP, CAPTCHA&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f9fafb;strokeColor=#9ca3af;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="530" width="290" height="75" as="geometry"/></mxCell><mxCell id="c28" value="" style="rounded=1;arcSize