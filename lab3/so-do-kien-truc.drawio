;fontColor=#2563eb;fontStyle=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="160" as="sourcePoint"/><mxPoint x="760" y="160" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="c87" value="(2) 200 – index.html, style.css, script.js (express.static)" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#16a34a;strokeWidth=2;dashed=1;fontColor=#16a34a;fontStyle=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="194" as="sourcePoint"/><mxPoint x="440" y="194" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="c88" value="Nhập username, password → bấm Đăng nhập" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6b7280;strokeWidth=2;fontColor=#6b7280;fontStyle=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="234" as="sourcePoint"/><mxPoint x="440" y="234" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="c89" value="Báo lỗi dưới ô nhập – KHÔNG gửi request" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#dc2626;strokeWidth=2;dashed=1;fontColor=#dc2626;fontStyle=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="328" as="sourcePoint"/><mxPoint x="160" y="328" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="c90" value="(4) POST /api/login  Content-Type: application/json  {username, password}" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#2563eb;strokeWidth=2;fontColor=#2563eb;fontStyle=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="378" as="sourcePoint"/><mxPoint x="760" y="378" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="c91" value="400 {success:false, message:&quot;Username phải dài 3–30 ký tự...&quot;}" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#dc2626;strokeWidth=2;dashed=1;fontColor=#dc2626;fontStyle=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="458" as="sourcePoint"/><mxPoint x="440" y="458" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="c92" value="(5) so khớp username / password" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#9333ea;strokeWidth=2;fontColor=#9333ea;fontStyle=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="546" as="sourcePoint"/><mxPoint x="1340" y="546" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="c93" value="khớp / không khớp" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#9333ea;strokeWidth=2;dashed=1;fontColor=#9333ea;fontStyle=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="578" as="sourcePoint"/><mxPoint x="760" y="578" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="c94" value="401 {success:false, message:&quot;Sai username hoặc password.&quot;}" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#dc2626;strokeWidth=2;dashed=1;fontColor=#dc2626;fontStyle=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="650" as="sourcePoint"/><mxPoint x="440" y="650" as="targetPoint"/><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="c95" value="(6) tạo session: req.session.user = {username, loginAt}" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#9333ea;strokeWidth=2;fontColor=#9333ea;fontStyle=1;font